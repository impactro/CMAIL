# Copie para .env. Segredos reais nunca entram neste repositório.
CMAIL_MODE=demo
CMAIL_HOST=127.0.0.1
CMAIL_PORT=7420
CMAIL_OPEN_BROWSER=true
CMAIL_STATE_DIR=.state

# Para uma conta real, use mode=imap e aponte para um arquivo externo ao Git.
# CMAIL_MODE=imap
# CMAIL_ACCOUNT=usuario@example.com
# CMAIL_USERNAME=usuario@example.com
# CMAIL_PASSWORD_FILE=../../secrets/cmail.password
# CMAIL_IMAP_HOST=imap.example.com
# CMAIL_IMAP_PORT=993
# CMAIL_IMAP_SECURITY=ssl
# CMAIL_SMTP_HOST=smtp.example.com
# CMAIL_SMTP_PORT=587
# CMAIL_SMTP_SECURITY=starttls
# CMAIL_SENT_FOLDER=Sent
