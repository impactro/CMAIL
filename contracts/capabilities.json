{
  "schemaVersion": "1.0",
  "version": "26.9.11c",
  "packageVersion": "26.9.11.post2",
  "owner": "CMAIL",
  "capabilities": [
    {
      "id": "cmail.webmail",
      "status": "operational",
      "productionReady": false,
      "entrypoint": "python -m cmail serve",
      "network": "loopback-only",
      "providers": ["setup", "microsoft-graph", "gmail-api", "imap-smtp-web"],
      "authentication": "provider-owned-oauth-or-local-imap-secret",
      "accountModel": "one-account-per-operational-root"
    },
    {
      "id": "cmail.python-api",
      "status": "operational",
      "productionReady": false,
      "factory": "cmail:create_api",
      "authorization": "principal-and-capability",
      "webTokensAccepted": false
    },
    {
      "id": "cmail.lists",
      "status": "operational",
      "productionReady": false,
      "entrypoint": "python -m cmail lists",
      "storage": "module-owned SQLite"
    },
    {
      "id": "cmail.send",
      "status": "operational",
      "productionReady": false,
      "entrypoint": "python -m cmail send-prepare / send-execute",
      "requires": ["preview", "single-use confirmation", "--execute"],
      "uncertainFailureRetry": "blocked"
    }
  ]
}
